# DeepSeekちゃん デスクトップアプリ 環境変数サンプル
# このファイルを .env にコピーして使います（.env は Git 管理しません）。
# アプリの設定画面からキーを入力した場合は、ユーザーデータフォルダの .env に保存されます。
# 優先順位: 環境変数 > ユーザーデータ/.env > このフォルダの .env

# DeepSeek APIキー（https://platform.deepseek.com で取得）
DEEPSEEK_API_KEY=

# 任意: 開発者ツールを開きたいときだけ 1
# DEEPSEEK_CHAN_DEVTOOLS=1

# Qwen3-TTS クラウド方式（Alibaba DashScope）を使う場合のみ。
# ローカル方式（scripts/qwen-tts-server.py）では不要。
DASHSCOPE_API_KEY=
